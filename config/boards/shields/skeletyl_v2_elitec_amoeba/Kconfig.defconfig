endif

if SHIELD_SKELETYL_RIGHT

config ZMK_KEYBOARD_NAME
	default "Skeletyl_r"

endif

if SHIELD_SKELETYL_DONGLE

config ZMK_KEYBOARD_NAME
	default "Skeletyl_d"

config ZMK_SPLIT_BLE_ROLE_CENTRAL
	default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

